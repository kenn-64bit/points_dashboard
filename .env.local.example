# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser — used only inside lib/supabase.ts,
# which is only ever imported from app/api/** route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bulk import limits
NEXT_PUBLIC_MAX_IMPORT_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.csv,.xlsx,.xls

# Upstash Redis — used for API rate limiting (see middleware.ts, lib/rateLimit.ts).
# Create a free database at https://console.upstash.com and copy its REST credentials.
# If unset, rate limiting is disabled (requests are allowed through) rather than
# failing the whole app — but this should be configured before going to production.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
