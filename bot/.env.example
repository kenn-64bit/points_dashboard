# Copy to .env and fill in. The npm scripts load .env; on a host, set these
# as environment variables instead.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → your application → General Information → Application ID
# (only `npm run deploy-commands` needs it)
DISCORD_CLIENT_ID=
# Your server's ID (Discord → Settings → Advanced → Developer Mode, then
# right-click the server → Copy Server ID). Commands are registered to this
# server. Leave empty to register them globally, for every server the bot is in.
DISCORD_GUILD_ID=

# The dashboard's address, e.g. https://your-app.vercel.app
DASHBOARD_API_URL=http://localhost:3000
# Must equal BOT_API_SECRET in the dashboard's environment. 32+ characters:
#   openssl rand -base64 32
BOT_API_SECRET=

# The time zone that decides what "today" is (IANA name, e.g. Asia/Manila).
BOT_TIMEZONE=UTC
# How long to wait for the dashboard before giving up on a request, in ms.
API_TIMEOUT_MS=8000
